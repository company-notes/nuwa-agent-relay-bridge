[Unit]
Description=Nuwa Agent Relay Bridge
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nuwa-bridge start
WorkingDirectory=%h
EnvironmentFile=-%h/.config/nuwa-agent-relay-bridge/decision.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
UMask=0077

[Install]
WantedBy=default.target
